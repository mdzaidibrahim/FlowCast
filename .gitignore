!data/raw/Traffic Flow Prediction Dataset.docx

# Model weights (auto-trained in ~10-15s if not present)
artifacts/models/*
!artifacts/models/.gitkeep

# Outputs directory contents (auto-generated)
outputs/

# Local evaluation & private assignment notes
docs/*.pdf
docs/Decisions&guidelines.md
docs/doc.md
docs/sample_report.md

# IDE, OS, and temporary files
.DS_Store
.idea/
.vscode/
.agents/
.claude/
*.swp
*.swo
